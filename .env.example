# Copie para .env e ajuste. Em produção, DJANGO_DEBUG precisa ser false.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=velureaistanbul.com,www.velureaistanbul.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://velureaistanbul.com,https://www.velureaistanbul.com

# Opcional: onde ficam banco e uploads (padrão: dentro do projeto)
# DJANGO_DB_PATH=/home/usuario/dados/db.sqlite3
# DJANGO_MEDIA_ROOT=/home/usuario/public_html/media

# E-mail que avisa sobre novos contatos. Sem EMAIL_HOST, o aviso só é impresso
# no terminal (o contato continua salvo no admin).
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Site Velurea <nao-responda@velureaistanbul.com>
